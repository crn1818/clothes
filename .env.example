# Liga o modo rede (contas + feed compartilhado) no build.
# Sem estas variaveis o Croma roda local, e da para ligar a rede pela tela de
# Ajustes sem rebuildar.
#
# Os valores saem do painel do Supabase em Project Settings -> API.
# Serve a chave publishable moderna (sb_publishable_...) ou a anon legada
# (JWT eyJ...). Ela e publica por natureza: quem protege os dados e o RLS do
# supabase/schema.sql, nunca o segredo da chave.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
